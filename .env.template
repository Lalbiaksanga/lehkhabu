# ──────────────────────────────────────────────────────────────────────────
# Lehkhabu — Environment Variables Template
# Copy to .env and fill in real values.
# ──────────────────────────────────────────────────────────────────────────

# Supabase — Frontend (public keys only, safe to expose in browser)
# Get from: Supabase Dashboard → Settings → API → Project API keys
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Algolia Search (optional — app works without it)
# VITE_ALGOLIA_APP_ID=
# VITE_ALGOLIA_SEARCH_KEY=
# VITE_ALGOLIA_BOOKS_INDEX=lehkhabu_books
