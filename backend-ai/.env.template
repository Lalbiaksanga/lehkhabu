# ──────────────────────────────────────────────────────────────────────────
# Lehkhabu backend-ai — Environment Variables
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────────────────────────────────

# PostgreSQL — same database as backend-api
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/lehkhabu

# Gemini API Key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model overrides (defaults match app/core/config.py)
# EMBEDDING_MODEL=models/gemini-embedding-2-preview
# QA_MODEL=models/gemini-3.1-flash-lite-preview
# SUMMARY_MODEL=models/gemini-3.1-flash-lite-preview

# Internal secret for backend-api → backend-ai communication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=generate_with_python_secrets_token_hex_32

# Celery — PostgreSQL as broker (no Redis)
# Use sync driver URL (db+postgresql://), not asyncpg
CELERY_BROKER_URL=db+postgresql://postgres:password@localhost:5432/lehkhabu
CELERY_RESULT_BACKEND=db+postgresql://postgres:password@localhost:5432/lehkhabu

# CORS — comma-separated origins; use * only for local development
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
